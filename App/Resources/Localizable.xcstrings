          "stringUnit": {
            "state": "translated",
            "value": "Meeting anhand bisheriger Notizen vorbereiten"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據先前筆記準備會議摘要"
