          "stringUnit": {
            "state": "translated",
            "value": "錄音決定已變更。請重新開啟會議。"
          }
        }
      }
    },
    "Prepare brief…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting vorbereiten…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備會議摘要…"
          }
        }
      }
    },
    "Prepare a brief from your prior notes": {
      "extractionState": "manual",
      "localizations": {
