    "%lld of %lld speakers are still unconfirmed; the minutes will call them “Speaker 1” and so on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Sprechern sind noch unbestätigt. Im Protokoll heißen sie „Sprecher 1“ und so weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld speakers are still unconfirmed; the minutes will call them “Speaker 1” and so on."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 位發言者尚未確認；會議紀錄中將稱其為「發言者 1」等。"
          }
        }
      }
    },
