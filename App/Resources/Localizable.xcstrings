    "Transcription language is guessed as %@. Confirm it in Settings before you rely on a transcript.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Transkriptionssprache wird %1$@ vermutet. Bestätige sie in den Einstellungen, bevor du dich auf ein Transkript verlässt."
