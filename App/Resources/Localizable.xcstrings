    "4096": {
      "shouldTranslate": false
    },
    "A different version of this source meeting is already present. Steno will not overwrite, merge or duplicate it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Version dieses Quell-Meetings ist bereits vorhanden. Steno überschreibt, vereinigt und dupliziert sie nicht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此來源會議的另一版本已存在。Steno 不會覆寫、合併或複製該會議。"
          }
        }
      }
    },
    "A new transcript is added; the current one stays available as an earlier version. Speaker assignments for this meeting have to be confirmed again afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Transkript wird hinzugefügt. Das aktuelle bleibt als frühere Version erhalten. Die Sprecherzuordnungen für dieses Meeting müssen danach erneut bestätigt werden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增逐字稿；目前的逐字稿將保留為舊版本。此會議的發言者指派必須在之後重新確認。"
          }
        }
      }
    },
    "A newer transcription is ready. Your correction is shown instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Transkription ist fertig. Stattdessen wird deine Korrektur angezeigt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有較新的轉錄內容就緒。目前顯示的是您的修正。"
          }
        }
      }
    },
    "A person named %@ already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person namens %1$@ ist bereits vorhanden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名為 %1$@ 的人物已存在。"
          }
        }
      }
    },
    "A temporary meeting export could not be verified and was preserved for manual cleanup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein temporärer Meeting-Export konnte nicht verifiziert werden und wurde zur manuellen Bereinigung beibehalten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存會議匯出無法驗證，已保留以供手動清理。"
          }
        }
      }
    },
    "About 461 MB from huggingface.co": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 461 MB von huggingface.co"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約 461 MB，來自 huggingface.co"
          }
        }
      }
    },
    "Active apps use several microphones (%@). Choose one manually.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Apps verwenden mehrere Mikrofone (%1$@). Wähle eines manuell aus."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中的應用程式正在使用多個麥克風（%1$@）。請手動選取一個。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        }
      }
    },
    "Add endpoint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpunkt hinzufügen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增端點"
          }
        }
      }
    },
    "Add participant": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilnehmende Person hinzufügen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增參與者"
          }
        }
      }
    },
    "Added manually: no detected speech - click the name for contact details": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell hinzugefügt: keine Sprache erkannt. Klicke für Kontaktdaten auf den Namen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動新增：未偵測到語音 — 點擊姓名可查看聯絡資訊"
          }
        }
      }
    },
    "Adding %@ sends an unencrypted raw recording. Microphone tracks may contain other voices in the room. The package may remain as a cleartext file on the receiving device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Hinzufügen von %1$@ wird eine unverschlüsselte Originalaufnahme gesendet. Mikrofonspuren können weitere Stimmen im Raum enthalten. Das Paket kann als unverschlüsselte Datei auf dem Empfangsgerät verbleiben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 %1$@ 會傳送未加密的原始錄音。麥克風音軌可能包含空間中的其他聲音。該套件在接收裝置上可能會以明文檔案保留。"
          }
        }
      }
    },
    "AirDrop could not be opened directly. Activate Share meeting again to open the system Share menu, then choose AirDrop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop konnte nicht direkt geöffnet werden. Wähle erneut „Meeting teilen“, um das Freigabemenü des Systems zu öffnen, und wähle dann AirDrop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法直接開啟 AirDrop。請再次點選「分享會議」以開啟系統分享選單，然後選擇 AirDrop。"
          }
        }
      }
    },
    "All %lld voice sample%@, counter-evidence and meeting appearances move to %@. %@ disappears. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %1$lld Stimmproben%2$@, Gegenbelege und Meeting-Vorkommen werden zu %3$@ verschoben. %4$@ verschwindet. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All %1$lld voice sample%2$@, counter-evidence and meeting appearances move to %3$@. %4$@ disappears. This can't be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 %1$lld 個聲紋樣本%2$@、反證與會議發言紀錄都將移至 %3$@。%4$@ 將會消失。此動作無法復原。"
          }
        }
      }
    },
    "Allow and install": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben und installieren"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許並安裝"
          }
        }
      }
    },
    "An earlier temporary meeting export needs cleanup before another meeting can be shared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein früherer temporärer Meeting-Export muss bereinigt werden, bevor ein weiteres Meeting geteilt werden kann."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在分享其他會議之前，需要先清理先前的暫存會議匯出。"
          }
        }
      }
    },
    "Another meeting share is still active or needs cleanup. Finish or clean it before sharing another meeting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Meeting-Freigabe ist noch aktiv oder muss bereinigt werden. Schließe sie ab oder bereinige sie, bevor du ein weiteres Meeting teilst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一場會議分享仍在進行中或需要清理。請先完成或清理後再分享其他會議。"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰"
          }
        }
      }
    },
    "API type": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Typ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 類型"
          }
        }
      }
    },
    "Appears in the header of exported Markdown and stays on this Mac; this field is never sent to a language model. If you took part yourself, add yourself to that meeting's participants - that list does go to the model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint in der Kopfzeile exportierter Markdown-Dateien und bleibt auf diesem Mac. Dieses Feld wird nie an ein Sprachmodell gesendet. Wenn du selbst teilgenommen hast, füge dich den Teilnehmenden des Meetings hinzu. Diese Liste wird an das Modell gesendet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示於匯出的 Markdown 標頭並保留在此 Mac 上；此欄位絕不會傳送至語言模型。若您親自參與，請將自己加入該會議的參與者名單中 — 該名單會傳送給模型。"
          }
        }
      }
    },
    "Appears in the header of exported Markdown and stays on this Mac; this field is never sent to a language model. If you took part yourself, add yourself to that meeting's participants - that list does go to the model. You can skip this and add it later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint in der Kopfzeile exportierter Markdown-Dateien und bleibt auf diesem Mac. Dieses Feld wird nie an ein Sprachmodell gesendet. Wenn du selbst teilgenommen hast, füge dich den Teilnehmenden des Meetings hinzu. Diese Liste wird an das Modell gesendet. Du kannst dies überspringen und später in den Einstellungen ergänzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示於匯出的 Markdown 標頭並保留在此 Mac 上；此欄位絕不會傳送至語言模型。若您親自參與，請將自己加入該會議的參與者名單中 — 該名單會傳送給模型。您可以略過此步驟，稍後在「設定」中填寫。"
          }
        }
      }
    },
