    "No new speaker-recognition run was scheduled. Check the pending transcription or existing processing results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein neuer Sprechererkennungslauf eingeplant. Prüfe die ausstehende Transkription oder vorhandene Verarbeitungsergebnisse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未安排新的說話者辨識。請檢查待處理的逐字稿或現有處理結果。"
          }
        }
      }
    },
    "Recording recovery must finish before transcription can start. The original files are preserved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme muss erst wiederhergestellt werden, bevor die Transkription starten kann. Die Originaldateien bleiben erhalten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先完成錄音復原，才能開始轉錄。原始檔案仍保留。"
          }
        }
      }
    },
    "Record a conversation or choose New note to create a meeting draft.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne ein Gespräch auf oder wähle „Neue Notiz“ für einen Meeting-Entwurf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製對話，或選擇「新增筆記」建立會議草稿。"
          }
        }
      }
    },
    "The brief could not be prepared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meeting-Vorbereitung konnte nicht erstellt werden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備會前摘要。"
          }
        }
      }
    },
    "Audio will be recorded and transcribed into this note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird aufgenommen und in diese Notiz transkribiert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將錄製並轉錄至此筆記。"
          }
        }
      }
    },
    "Record into this note?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diese Notiz aufnehmen?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音至此筆記？"
          }
        }
      }
    },
    "That was a short recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war eine kurze Aufnahme."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段錄音很短。"
          }
        }
      }
    },
    "Your audio is saved. Would you like to transcribe it anyway?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahme ist gespeichert. Möchtest du sie trotzdem transkribieren?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊已儲存。仍要轉錄嗎？"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後"
          }
        }
      }
    },
    "Transcribe": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
