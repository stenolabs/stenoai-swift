      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ erneut transkribieren?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新轉錄「%1$@」嗎？"
          }
