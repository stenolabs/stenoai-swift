    "%@ (selected on the source device)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (auf dem Quellgerät ausgewählt)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（在來源裝置上選取）"
          }
        }
      }
    },
    "%@ disconnected. The microphone track is paused; system audio continues.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde getrennt. Die Mikrofonspur ist pausiert, das Systemaudio läuft weiter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已中斷連線。麥克風音軌已暫停，系統音訊錄製將繼續。"
          }
        }
      }
    },
    "%@ is not available. Choose another microphone before recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nicht verfügbar. Wähle vor der Aufnahme ein anderes Mikrofon."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 無法使用。請在錄音前選擇其他麥克風。"
          }
        }
      }
    },
    "%@ is not responding. The microphone track is paused; system audio continues.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ antwortet nicht. Die Mikrofonspur ist pausiert, das Systemaudio läuft weiter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 沒有回應。麥克風音軌已暫停，系統音訊錄製將繼續。"
          }
        }
      }
    },
    "%@ level": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegel: %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 音量"
          }
        }
      }
    },
    "%@ Transcript and speakers remain fully usable without a model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Transkript und Sprecher bleiben ohne Modell vollständig nutzbar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 逐字稿與發言者在沒有模型的情況下仍可完整使用。"
          }
        }
      }
    },
    "%@ You can skip this and add it later in Settings.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Du kannst dies überspringen und später in den Einstellungen hinzufügen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 您可以略過此步驟，稍後再於「設定」中新增。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld %%": {
      "shouldTranslate": false
    },
    "%lld direct meetings, %lld subfolders": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld direkte Meetings, %2$lld Unterordner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld direct meetings, %2$lld subfolders"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個直接會議，%2$lld 個子資料夾"
          }
        }
      }
    },
    "%lld file(s) are in the legacy app’s delete queue and will not be imported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Datei(en) befinden sich in der Löschwarteschlange der alten App und werden nicht importiert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版應用程式的刪除佇列中有 %lld 個檔案，不會進行匯入。"
          }
        }
      }
    },
    "%lld imported meetings need attention because their processing could not be resumed. Other meetings and recording remain available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld importierte Meetings benötigen Aufmerksamkeit, weil ihre Verarbeitung nicht fortgesetzt werden konnte. Andere Meetings und die Aufnahmefunktion bleiben verfügbar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 場匯入的會議需要留意，因為無法繼續處理。其他會議與錄音功能仍可正常使用。"
          }
        }
      }
    },
    "%lld Meetings Selected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Meetings ausgewählt"
