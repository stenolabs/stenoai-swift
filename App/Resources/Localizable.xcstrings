    "demo.data.attribution.copy": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drei Aufnahmen wurden aus erfundenem deutschem Text vorgerendert. Piper und sein Stimm-Repository stehen unter der MIT-Lizenz. Die Modellkarte der Stimme nennt MLS unter CC BY 4.0. Vollständige Quellenangaben sind im Datensatz enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The three recordings are pre-rendered from fictional German text. Piper and its voice repository are MIT-licensed; the voice model card names MLS as CC BY 4.0. Full attribution is bundled with the dataset."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三段錄音均由虛構的德語文字預先產生。Piper 及其語音儲存庫採用 MIT 授權條款；語音模型卡註明 MLS 為 CC BY 4.0。完整的來源資訊已隨資料集附帶。"
          }
        }
      }
    },
