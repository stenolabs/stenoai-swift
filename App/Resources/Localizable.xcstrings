    "Deleted %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde gelöscht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除 %1$@。"
          }
        }
      }
    },
    "Deleting “%@” removes its configuration and saved API key from this Mac. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen von „%1$@“ werden die Konfiguration und der gespeicherte API-Schlüssel von diesem Mac entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除「%1$@」將會從此 Mac 移除其設定與已儲存的 API 金鑰。此動作無法復原。"
          }
        }
      }
    },
    "Demo meetings cannot create or change real voice profiles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo-Meetings können keine echten Stimmprofile erstellen oder ändern."
