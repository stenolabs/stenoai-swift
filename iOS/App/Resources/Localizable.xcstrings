      }
    },
    "Your correction is shown instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen wird deine Korrektur angezeigt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示的是您的修正。"
          }
        }
      }
    },
    "Your correction remains available as an earlier revision.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Korrektur bleibt als frühere Revision erhalten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的修正將保留為較早的修訂版本。"
          }
        }
      }
    },
    "Your device is set to %@. Steno transcribes in %@ regardless, because the device setting says nothing about the language people speak in the room.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gerät ist auf %1$@ eingestellt. Steno transkribiert trotzdem in %2$@, weil die Geräteeinstellung nichts darüber aussagt, welche Sprache die Personen im Raum sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your device is set to %1$@. Steno transcribes in %2$@ regardless, because the device setting says nothing about the language people speak in the room."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的裝置設定為 %1$@。Steno 仍會使用 %2$@ 進行轉錄，因為裝置設定無法反映空間中人們實際使用的語言。"
          }
        }
      }
    },
    "Your edited transcript is still shown. Use the speaker labels to switch to the separated version; your edit remains saved as an earlier revision.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein bearbeitetes Transkript wird weiterhin angezeigt. Verwende die Sprecherkennungen, um zur getrennten Version zu wechseln. Deine Bearbeitung bleibt als frühere Revision gespeichert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍顯示您編輯過的逐字稿。使用發言者標籤可切換至已分離的版本；您的編輯仍會儲存為較早的修訂版本。"
          }
        }
      }
    },
