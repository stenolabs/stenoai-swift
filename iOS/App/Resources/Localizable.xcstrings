        }
      }
    },
    "The import outcome is retained until Steno can remove its private prepared copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Importergebnis bleibt erhalten, bis Steno seine private vorbereitete Kopie entfernen kann."
