    "Add marker": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markierung hinzufügen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增標記"
          }
        }
      }
    },
    "Adding %@ sends an unencrypted raw recording. Microphone tracks may contain other voices in the room. The package may remain as a cleartext file on the receiving device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Hinzufügen von %1$@ wird eine unverschlüsselte Originalaufnahme gesendet. Mikrofonspuren können weitere Stimmen im Raum enthalten. Das Paket kann als unverschlüsselte Datei auf dem Empfangsgerät verbleiben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 %1$@ 會傳送未加密的原始錄音。麥克風音軌可能包含空間中的其他聲音。該套件在接收裝置上可能會以明文檔案保留。"
          }
        }
      }
    },
    "Additional": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlich"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他"
          }
        }
      }
    },
    "Adds a timestamped marker to this recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt dieser Aufnahme eine Markierung mit Zeitstempel hinzu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此錄音新增帶有時間戳記的標記。"
          }
        }
      }
    },
