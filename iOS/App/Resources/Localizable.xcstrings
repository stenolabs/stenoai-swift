    "Stop the recording before installing a model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die Aufnahme, bevor du ein Modell installierst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在安裝模型前請先停止錄音。"
          }
        }
      }
    },
    "Stop the recording before installing speaker separation models. Recording and transcription work without them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die Aufnahme, bevor du Modelle zur Sprechertrennung installierst. Aufnahme und Transkription funktionieren auch ohne sie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在安裝語者分離模型前請先停止錄音。即使沒有這些模型，錄音與轉錄仍可正常運作。"
          }
        }
      }
    },
    "Stop the recording before switching transcript revisions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die Aufnahme, bevor du die Transkriptrevision wechselst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在切換逐字稿修訂版本前請先停止錄音。"
          }
        }
      }
    },
    "Subfolders can contain meetings but no further folders.": {
      "localizations": {
