    "Audio saved. No transcript yet. If the speech model is missing, install it under Audio readiness. Steno retries automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio gespeichert. Noch kein Transkript. Falls das Sprachmodell fehlt, installiere es unter „Audiobereitschaft“. Steno versucht es automatisch erneut."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊已儲存。尚未產生逐字稿。若缺少語音模型，請在「音訊就緒狀態」下安裝。Steno 會自動重試。"
          }
        }
      }
    },
