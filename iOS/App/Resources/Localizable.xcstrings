          "stringUnit": {
            "state": "translated",
            "value": "%1$@（在來源裝置上選取）"
          }
        }
      }
    },
    "%@ was created, but could not be added to this meeting. The person remains available to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde erstellt, konnte diesem Meeting aber nicht hinzugefügt werden. Die Person bleibt für einen erneuten Versuch verfügbar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已建立 %1$@，但無法加入此會議。該人物檔案仍保留，可重試加入。"
          }
        }
      }
    },
    "%@, %@ bytes (about %@ MB)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ Byte (etwa %3$@ MB)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@ bytes (about %3$@ MB)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@ 位元組（約 %3$@ MB）"
          }
        }
      }
    },
    "%lld dBFS, peak %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dBFS, Spitze %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld dBFS, peak %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dBFS，峰值 %2$lld"
          }
        }
      }
    },
    "%lld direct meetings, %lld subfolders": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld direkte Meetings, %2$lld Unterordner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld direct meetings, %2$lld subfolders"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個直接會議，%2$lld 個子資料夾"
          }
        }
      }
    },
    "%lld imported meetings need attention because their processing could not be resumed. Other meetings and recording remain available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld importierte Meetings benötigen Aufmerksamkeit, weil ihre Verarbeitung nicht fortgesetzt werden konnte. Andere Meetings und die Aufnahmefunktion bleiben verfügbar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 場匯入的會議需要留意，因為無法繼續處理。其他會議與錄音功能仍可正常使用。"
          }
        }
      }
    },
    "%lld tracks selected, %@ total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Spuren ausgewählt, insgesamt %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld tracks selected, %2$@ total"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選取 %1$lld 條音軌，共 %2$@"
          }
        }
      }
    },
    "•": {
      "shouldTranslate": false
    },
    "1 track selected, %@ total": {
      "localizations": {
