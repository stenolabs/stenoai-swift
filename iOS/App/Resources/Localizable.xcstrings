    "meeting.deletion.message": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gesamte Meeting mit Originalaufnahmen, Transkripten, Notizen und Protokollen wird nach „Zuletzt gelöscht“ verschoben. Du kannst es dort jederzeit wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entire meeting, including its original recordings, transcripts, notes, and reports, moves to Recently deleted. You can restore it there at any time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個會議（包括原始錄音、逐字稿、筆記和紀錄）都會移至「最近刪除」。你隨時可以在那裡將其復原。"
          }
        }
      }
    },
    "meeting.retranscription.message": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno fügt eine neue Transkriptrevision hinzu und behält das aktuelle Transkript und die Korrekturen als frühere Revisionen.\nDie Sprechertrennung läuft mit neuen Cluster-Kennungen erneut, daher müssen Sprecher danach erneut bestätigt werden.\nDeine Korrekturen werden niemals stillschweigend überschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Steno adds a new transcript revision and keeps the current transcript and corrections as earlier revisions.\nSpeaker separation runs again with new cluster identifiers, so speakers must be confirmed again.\nYour corrections are never silently overwritten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將使用選取的模型重新轉錄此會議。"
          }
        }
      }
    },
