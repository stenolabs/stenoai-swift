    "4096": {
      "shouldTranslate": false
    },
    "A different version of this meeting is already present. Steno will not overwrite, merge, or duplicate it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Version dieses Meetings ist bereits vorhanden. Steno überschreibt, vereinigt und dupliziert sie nicht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此會議的另一版本已存在。Steno 不會覆寫、合併或複製該會議。"
          }
        }
      }
    },
    "A meeting with this ID is not demo data. It cannot be installed or replaced as demo data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meeting mit dieser Kennung gehört nicht zu den Demodaten. Es kann nicht als Demodaten installiert oder ersetzt werden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "具有此 ID 的會議不是示範資料。無法將其安裝或取代為示範資料。"
          }
        }
      }
    },
    "A newer transcription is ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Transkription ist fertig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有較新的轉錄內容就緒。"
          }
        }
      }
    },
    "A person named %@ already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person namens %1$@ ist bereits vorhanden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名為 %1$@ 的人物已存在。"
          }
        }
      }
    },
    "A recording is running; its screen shows the level.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufnahme läuft. Der Pegel wird auf dem Aufnahmebildschirm angezeigt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音正在進行中；錄音畫面會顯示音量。"
          }
        }
      }
    },
    "A transcript is required before minutes can be generated.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Protokollerstellung ist ein Transkript erforderlich."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在產生會議紀錄之前需要先有逐字稿。"
          }
        }
      }
    },
    "A transcript line cannot be empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Transkriptzeile darf nicht leer sein."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字稿行不能為空。"
          }
        }
      }
    },
    "A transcription for this meeting is already queued or running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Transkription für dieses Meeting ist bereits vorgemerkt oder läuft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此會議的轉錄已在排隊中或正在執行。"
          }
        }
      }
    },
    "About 461 MB from huggingface.co": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 461 MB von huggingface.co"
