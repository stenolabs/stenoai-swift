    "Your changes are kept unless you choose Replace all demo data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen bleiben erhalten, sofern du nicht „Alle Demodaten ersetzen“ auswählst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您選擇「取代所有示範資料」，否則您的變更將保留。"
