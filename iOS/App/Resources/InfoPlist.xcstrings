    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI verbindet sich mit deinem ausgewählten Sprachmodellserver, wenn du die Verbindung testest, ein Protokoll oder eine Besprechungsvorbereitung erstellst oder eine Chatnachricht sendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI connects to your selected language model server when you test the connection, generate minutes or meeting preparation, or send a chat message."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI 會在您測試連線、產生會議紀錄或會前準備，或傳送聊天訊息時，連線至您選擇的語言模型伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI zeichnet dein Mikrofon auf, damit Gespräche lokal auf diesem Gerät transkribiert werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI records your microphone so it can transcribe conversations locally on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI 錄製您的麥克風以在此裝置本機轉錄對話。"
          }
        }
      }
    },
    "Steno Meeting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno-Meeting"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StenoAI 會議"
          }
        }
      }
    }
  },
  "version": "1.0"
